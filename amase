#!/usr/bin/env bash
# ==============================================================================
# AMASE Global Autonomous Swarm Orchestrator
# Executes tasks continuously in a loop until BACKLOG.md is exhausted.
# Usage:
#   amase init [dir]       - Initialize a project with .amase governance
#   amase [dir]            - Run continuous autonomous loop on target repository
# ==============================================================================
set -euo pipefail

# Set TARGET_DIR early if not already set (for subcommands like 'config')
if [[ -z "${TARGET_DIR:-}" ]]; then
  TARGET_DIR="$(pwd)"
fi

AMASE_VERSION="2.1.0"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

show_help() {
  cat <<'EOF'
AMASE - Autonomous Multi-Agent Swarm Orchestrator (v2.1)
Continuous unattended execution of software backlogs using $0 free fleet.

USAGE:
  amase [OPTIONS] [DIRECTORY]
  amase run [OPTIONS] [DIRECTORY]
  amase <SUBCOMMAND> [ARGS...]

CORE COMMANDS:
  amase [dir]                     Run continuous autonomous loop on target repository
  amase run [dir]                 Run continuous autonomous loop (alias)
  amase status [dir]              Show unified project, backlog, worktree, and fleet status
  amase init [dir]                Initialize project with .amase governance files
  amase doctor [dir] [--heal]     Verify environment, models, and project governance
  amase parallel [dir] [opts]     Dispatch non-conflicting tasks concurrently in parallel worktrees
  amase abort <task_id> [dir]     Safely unmount worktree and prune task branch
  amase task [--dry-run] <goal>   Decompose objective via Project Manager and append to BACKLOG.md
  amase config [options]          View or modify .amase/config.json settings
  amase stats [dir]               Show telemetry, token usage, cost ($0), and model stats
  amase incidents [options]       List recorded engine incidents and failure retrospectives
  amase ui-check <url>            Headless layout collision, asset, and UI validator (CHISLE)
  amase test-wiring [dir]         Dry-run validation of the worker dispatch and gating cycle

OPTIONS:
  -h, --help                      Display this help menu
  -v, --version                   Display AMASE version
  --headless, --no-gui            Run workers in background without opening terminal tabs
  --pro                           Force Pro AI model tier (`agy` Pro models)
  --once, -1, step                Execute a single task and exit cleanly
  --no-inhibit                    Bypass systemd-inhibit sleep inhibition lock

EXAMPLES:
  amase                           # Start autonomous loop in current directory
  amase ~/dev/kandidat            # Run loop on external project
  amase init ~/dev/my-rust-app    # Scaffold governance for a Rust project
  amase doctor --heal             # Check health and auto-heal missing governance
  amase config --set-concurrency parallel
  amase abort TASK-54             # Abort failed task and clean working tree

DOCUMENTATION:
  Repository: https://github.com/joaodantas91/amase
  Governance: <project>/.amase/config.json, scope.md, discovery.md, test-gate.sh
EOF
}

# Support 'amase run' subcommand alias and global headless/once flags
while [[ $# -gt 0 ]]; do
  case "$1" in
    run)
      shift
      ;;
    --headless|--no-gui)
      export AMASE_GUI_TAB=0
      shift
      ;;
    --pro)
      export AMASE_MODEL_TIER=pro
      shift
      ;;
    --once|-1|--single|step)
      export AMASE_ONCE=1
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
  show_help
  exit 0
fi

if [[ "${1:-}" == "-v" || "${1:-}" == "--version" || "${1:-}" == "version" ]]; then
  echo "AMASE v$AMASE_VERSION"
  exit 0
fi

sync_dirty_governance() {
  local repo="${1:-$(pwd)}"
  if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local dirty_gov
    dirty_gov=$(git -C "$repo" status --porcelain BACKLOG.md .amase 2>/dev/null || true)
    if [[ -n "$dirty_gov" ]]; then
      echo "[+] Auto-committing uncommitted governance state on $(git -C "$repo" branch --show-current)..."
      git -C "$repo" add BACKLOG.md .amase/ 2>/dev/null || true
      git -C "$repo" commit -m "chore(amase): sync governance and backlog state" 2>/dev/null || true
    fi
  fi
}

auto_heal_governance() {
  local dir="${1:-$(pwd)}"
  if [[ -d "$dir/.amase" ]]; then
    local needs_heal=0
    if [[ ! -f "$dir/.amase/config.json" ]] || [[ ! -f "$dir/.amase/scope.md" ]] || [[ ! -f "$dir/.amase/test-gate.sh" ]]; then
      needs_heal=1
    else
      local ver
      ver=$(jq -r '.schema_version // 0' "$dir/.amase/config.json" 2>/dev/null || echo "0")
      if [[ "$ver" -lt 2 ]]; then
        needs_heal=1
      fi
    fi
    if [[ "$needs_heal" -eq 1 ]]; then
      echo "[+] Auto-healing .amase governance to schema v2 in $dir..."
      "$SCRIPT_DIR/scripts/init-project.sh" "$dir" --heal >/dev/null 2>&1 || true
    fi
  fi
}

if [[ "${1:-}" == "init" ]]; then
  shift
  INIT_DIR="${1:-.}"
  exec "$SCRIPT_DIR/scripts/init-project.sh" "$INIT_DIR"
fi

if [[ "${1:-}" == "doctor" ]]; then
  shift
  DOCTOR_TARGET="${1:-$(pwd)}"
  if [[ "$DOCTOR_TARGET" == --* ]]; then
    DOCTOR_TARGET="$(pwd)"
  fi
  auto_heal_governance "$DOCTOR_TARGET"
  exec "$SCRIPT_DIR/scripts/doctor.py" "$@"
fi

if [[ "${1:-}" == "abort" ]]; then
  shift
  TASK_ID="${1:-}"
  if [[ -z "$TASK_ID" ]]; then
    echo "Usage: amase abort <task_id> [dir]"
    exit 1
  fi
  TARGET_REPO="${2:-$TARGET_DIR}"
  exec "$SCRIPT_DIR/scripts/abort-task.sh" --repo "$TARGET_REPO" --task "$TASK_ID"
fi

if [[ "${1:-}" == "status" ]]; then
  shift
  exec "$SCRIPT_DIR/scripts/status.py" "${1:-$(pwd)}"
fi

if [[ "${1:-}" == "stats" ]]; then
  shift
  exec "$SCRIPT_DIR/scripts/stats.py" "${1:-.}"
fi

if [[ "${1:-}" == "incidents" ]]; then
  shift
  exec "$SCRIPT_DIR/scripts/engine_incident.py" --list "$@"
fi

if [[ "${1:-}" == "parallel" ]]; then
  shift
  auto_heal_governance "$TARGET_DIR"
  sync_dirty_governance "$TARGET_DIR"
  exec "$SCRIPT_DIR/scripts/parallel_dispatcher.py" --repo "$TARGET_DIR" "$@"
fi

if [[ "${1:-}" == "ui-check" ]]; then
  shift
  exec "$SCRIPT_DIR/scripts/ui_validator.py" "$@"
fi

if [[ "${1:-}" == "test-wiring" ]]; then
  shift
  exec "$SCRIPT_DIR/scripts/test-wiring.sh" "${1:-$(pwd)}"
fi

if [[ "${1:-}" == "config" ]]; then
  shift
  auto_heal_governance "$TARGET_DIR"
  CONFIG_FILE="$TARGET_DIR/.amase/config.json"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$SCRIPT_DIR/.amase/config.json"
  fi
  if [[ "${1:-}" == "--show" ]]; then
    if [ -f "$CONFIG_FILE" ]; then
      cat "$CONFIG_FILE"
    else
      echo "{}"
    fi
    exit 0
  fi
  if [[ "${1:-}" == "--model-tier" ]]; then
    if [ -f "$CONFIG_FILE" ]; then
      jq -r '.model_tier // "free"' "$CONFIG_FILE" 2>/dev/null || echo "free"
    else
      echo "free"
    fi
    exit 0
  fi
  if [[ "${1:-}" == "--mode" ]]; then
    if [ -f "$CONFIG_FILE" ]; then
      jq -r '.mode // "autonomous"' "$CONFIG_FILE" 2>/dev/null || echo "autonomous"
    else
      echo "autonomous"
    fi
    exit 0
  fi
  if [[ "${1:-}" == "--concurrency" ]]; then
    if [ -f "$CONFIG_FILE" ]; then
      python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        data = json.load(f)
    c = data.get('concurrency', 'sequential')
    if isinstance(c, dict):
        print(c.get('mode', 'sequential'))
    else:
        print(c or 'sequential')
except Exception:
    print('sequential')
"
    else
      echo "sequential"
    fi
    exit 0
  fi
  if [[ "${1:-}" == "--set-concurrency" ]]; then
    shift
    NEW_CONCURRENCY="${1:-}"
    if [[ "$NEW_CONCURRENCY" != "sequential" && "$NEW_CONCURRENCY" != "parallel" ]]; then
      echo "Error: concurrency must be 'sequential' or 'parallel'" >&2
      exit 1
    fi
    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    data = json.load(f)
if isinstance(data.get('concurrency'), dict):
    data['concurrency']['mode'] = '$NEW_CONCURRENCY'
else:
    data['concurrency'] = '$NEW_CONCURRENCY'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(data, f, indent=2)
"
    echo "[+] Concurrency set to: $NEW_CONCURRENCY"
    exit 0
  fi
  if [[ "${1:-}" == "--set-mode" ]]; then
    shift
    NEW_MODE="${1:-}"
    if [[ "$NEW_MODE" != "autonomous" && "$NEW_MODE" != "interactive" && "$NEW_MODE" != "manual" ]]; then
      echo "Error: mode must be 'autonomous', 'interactive', or 'manual'" >&2
      exit 1
    fi
    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    data = json.load(f)
data['mode'] = '$NEW_MODE'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(data, f, indent=2)
"
    echo "[+] Mode set to: $NEW_MODE"
    exit 0
  fi
  if [[ "${1:-}" == "--set-tier" ]]; then
    shift
    NEW_TIER="${1:-}"
    if [[ "$NEW_TIER" != "free" && "$NEW_TIER" != "pro" ]]; then
      echo "Error: tier must be 'free' or 'pro'" >&2
      exit 1
    fi
    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    data = json.load(f)
data['model_tier'] = '$NEW_TIER'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(data, f, indent=2)
"
    echo "[+] Model tier set to: $NEW_TIER"
    exit 0
  fi
  if [[ "${1:-}" == "--discovery" ]]; then
    if [ -f "$CONFIG_FILE" ]; then
      jq -r '.discovery.enabled // false' "$CONFIG_FILE" 2>/dev/null || echo "false"
    else
      echo "false"
    fi
    exit 0
  fi
  echo "Usage: amase config [--show|--model-tier|--mode|--concurrency|--set-concurrency <sequential|parallel>|--set-mode <mode>|--discovery]"
  exit 1
fi

if [[ "${1:-}" == "task" ]]; then
  DRY_RUN=false
  TARGET_DIR="${TARGET_DIR:-$(pwd)}"
  shift
  OBJECTIVE_PARTS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=true
        shift
        ;;
      --repo)
        if [[ -z "${2:-}" ]]; then
          echo "Error: --repo requires a directory argument" >&2
          exit 1
        fi
        TARGET_DIR="$2"
        shift 2
        ;;
      *)
        OBJECTIVE_PARTS+=("$1")
        shift
        ;;
    esac
  done
  TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
  BACKLOG_FILE="$TARGET_DIR/BACKLOG.md"
  SCOPE_FILE="$TARGET_DIR/.amase/scope.md"
  OBJECTIVE="${OBJECTIVE_PARTS[*]:-}"

  STATUS_SUMMARY=""
  if [[ -f "$SCRIPT_DIR/scripts/status.py" ]]; then
    STATUS_SUMMARY=$(python3 "$SCRIPT_DIR/scripts/status.py" "$TARGET_DIR" 2>/dev/null | sed $'s/\033\\[[0-9;]*m//g' || true)
  fi

  PM_ARGS=(
    --repo "$TARGET_DIR"
    --backlog "$BACKLOG_FILE"
    --scope "$SCOPE_FILE"
  )
  if [[ -n "$OBJECTIVE" ]]; then
    PM_ARGS+=(--objective "$OBJECTIVE")
  fi
  if [[ -n "$STATUS_SUMMARY" ]]; then
    PM_ARGS+=(--status "$STATUS_SUMMARY")
  fi
  if [[ "$DRY_RUN" == true ]]; then
    PM_ARGS+=(--dry-run)
    python3 "$SCRIPT_DIR/scripts/pm.py" "${PM_ARGS[@]}"
  else
    PM_ARGS+=(--append)
    python3 "$SCRIPT_DIR/scripts/pm.py" "${PM_ARGS[@]}"
    echo "[+] Appended task to $BACKLOG_FILE"
  fi
  exit 0
fi

# Parse optional run alias and flags
while [[ $# -gt 0 ]]; do
  case "$1" in
    run)
      shift
      ;;
    --headless|--no-gui)
      export AMASE_GUI_TAB=0
      shift
      ;;
    --pro)
      export AMASE_MODEL_TIER=pro
      shift
      ;;
    --once|-1|--single|step)
      export AMASE_ONCE=1
      shift
      ;;
    --no-inhibit)
      AMASE_INHIBITED=1
      shift
      ;;
    *)
      break
      ;;
  esac
done

TARGET_DIR="${1:-$(pwd)}"
if [[ "$TARGET_DIR" == "--no-inhibit" ]]; then
  AMASE_INHIBITED=1
  shift
  TARGET_DIR="${1:-$(pwd)}"
fi
cd "$TARGET_DIR"
auto_heal_governance "$TARGET_DIR"
sync_dirty_governance "$TARGET_DIR"

# Sleep & Lid-Close Inhibition: prevent Linux laptop sleep/hibernation while autonomous loop is active
if command -v systemd-inhibit >/dev/null 2>&1 && [[ -z "${AMASE_INHIBITED:-}" ]]; then
  echo "[+] Requesting system sleep inhibition lock (preventing idle, sleep, and lid-close suspension)..."
  exec systemd-inhibit \
    --what=idle:sleep:handle-lid-switch \
    --who=AMASE \
    --why="AMASE autonomous loop active on $(basename "$TARGET_DIR")" \
    env AMASE_INHIBITED=1 "$0" "$@"
fi

if [ ! -d ".git" ]; then
  echo "[-] Error: $TARGET_DIR is not a git repository."
  exit 1
fi

BACKLOG_FILE="$TARGET_DIR/BACKLOG.md"
AUDIT_FILE="$TARGET_DIR/AUDIT.md"

if [ ! -f "$BACKLOG_FILE" ]; then
  echo "[-] No BACKLOG.md found in $TARGET_DIR."
  echo "[-] Run 'amase init' first or create BACKLOG.md."
  exit 1
fi

echo "=========================================================="
echo " AMASE Autonomous Orchestration Loop Started"
echo " Target Project: $TARGET_DIR"
echo " Mode:           Continuous Unattended Execution"
echo " Timestamp:      $(date -Iseconds)"
echo "=========================================================="

while true; do
  # 1. Audit Ingestion Gate: Check for unaddressed CRITICAL / HIGH vulnerabilities
  if [ -f "$AUDIT_FILE" ]; then
    UNRESOLVED_CRITICAL=$(grep -E "^- \[ \] \[(CRITICAL|HIGH)\]" "$AUDIT_FILE" || true)
    if [ -n "$UNRESOLVED_CRITICAL" ]; then
      echo "[!] CRITICAL/HIGH issue detected in $AUDIT_FILE:"
      echo "$UNRESOLVED_CRITICAL"
      echo "[!] Halting feature pipeline to prioritize security remediation."
      if ! grep -q "TASK-SEC-" "$BACKLOG_FILE"; then
        SEC_TASK="- [ ] **TASK-SEC-01: Remediate Sentinel Audit Findings**\n  - **Goal:** Fix critical/high security issues flagged in AUDIT.md.\n  - **Files:** AUDIT.md and target modules.\n  - **Criteria:** Tests pass, Sentinel marks clean."
        sed -i "8i $SEC_TASK\n" "$BACKLOG_FILE"
        echo "[+] Auto-prepended TASK-SEC-01 to top of BACKLOG.md."
      fi
    fi
  fi

# 2. Autonomous Backlog Lookahead (Top up if fewer than 3 tasks remain)
  # Check config.json for mode and discovery settings
  CONFIG_FILE="$TARGET_DIR/.amase/config.json"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$SCRIPT_DIR/.amase/config.json"
  fi
  MODE=$(jq -r '.mode // "manual"' "$CONFIG_FILE" 2>/dev/null || echo "manual")
  DISCOVERY_ENABLED=$(jq -r '.discovery.enabled // false' "$CONFIG_FILE" 2>/dev/null || echo "false")

  PENDING_COUNT=$(grep -cE "^- \[ \]" "$BACKLOG_FILE" 2>/dev/null || true)
  PENDING_COUNT=${PENDING_COUNT:-0}
  if [ "$PENDING_COUNT" -lt 3 ]; then
    if [[ "$MODE" == "manual" || "$DISCOVERY_ENABLED" == "false" ]]; then
      echo "[!] Backlog running low ($PENDING_COUNT pending). Scout disabled (mode=manual or discovery.enabled=false)."
    else
      echo "[!] Backlog running low ($PENDING_COUNT pending). Triggering Scout expansion..."
      "$SCRIPT_DIR/scripts/scout.py" --backlog "$BACKLOG_FILE" | python3 "$SCRIPT_DIR/scripts/scout.py" --sanitize --backlog "$BACKLOG_FILE" >> "$BACKLOG_FILE" || true
    fi
    PENDING_COUNT=$(grep -cE "^- \[ \]" "$BACKLOG_FILE" 2>/dev/null || true)
    PENDING_COUNT=${PENDING_COUNT:-0}
  fi

  # 3. Check Concurrency Mode (sequential vs parallel)
  CONCURRENCY_MODE=$(python3 -c "
import json
try:
    with open('$CONFIG_FILE') as f:
        d = json.load(f)
    c = d.get('concurrency', 'sequential')
    if isinstance(c, dict):
        print(c.get('mode', 'sequential'))
    else:
        print(c or 'sequential')
except Exception:
    print('sequential')
" 2>/dev/null || echo "sequential")

  if [[ "$CONCURRENCY_MODE" == "parallel" ]]; then
    echo "[+] Concurrency mode: 'parallel'. Evaluating non-conflicting task batches..."
    if "$SCRIPT_DIR/scripts/parallel_dispatcher.py" --repo "$TARGET_DIR"; then
      echo "[+] Parallel execution cycle completed. Refreshing loop..."
      continue
    else
      echo "[-] Parallel dispatcher encountered an issue; falling back to sequential dispatch..."
    fi
  fi

  # 4. Find the first uncompleted task line (Sequential fallback or default)
  NEXT_TASK_LINE=$(grep -E "^- \[ \]" "$BACKLOG_FILE" | head -n 1 || true)
  if [ -z "$NEXT_TASK_LINE" ]; then
    echo "[+] All tasks in BACKLOG.md are completed [x]. Swarm loop finished!"
    exit 0
  fi

  # Extract task ID (e.g. TASK-01) and description
  TASK_ID=$(echo "$NEXT_TASK_LINE" | grep -oE "TASK-[0-9A-Z-]+" | head -n 1 || echo "")
  TASK_DESC=$(echo "$NEXT_TASK_LINE" | sed -E 's/^- \[ \] (\*\*TASK-[0-9A-Z-]+:?\*\* )?//')

  if [[ -z "$TASK_ID" ]]; then
    TASK_ID=$(echo "$TASK_DESC" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g' | cut -c1-20)
  fi

  TOTAL_TASKS=$(grep -cE "^- \[[ x]\]" "$BACKLOG_FILE" 2>/dev/null || true)
  TOTAL_TASKS=${TOTAL_TASKS:-1}
  [[ "$TOTAL_TASKS" -eq 0 ]] && TOTAL_TASKS=1
  DONE_TASKS=$(grep -cE "^- \[x\]" "$BACKLOG_FILE" 2>/dev/null || true)
  DONE_TASKS=${DONE_TASKS:-0}
  PROGRESS_PCT=0
  if [[ "$TOTAL_TASKS" -gt 0 ]]; then
    PROGRESS_PCT=$(( (DONE_TASKS * 100) / TOTAL_TASKS ))
  fi

  echo ""
  echo "=========================================================="
  echo " [▶] STARTING TASK: $TASK_ID"
  echo " [▶] Title:    $TASK_DESC"
  echo " [▶] Progress: $DONE_TASKS/$TOTAL_TASKS completed ($PROGRESS_PCT%) | $PENDING_COUNT pending"
  echo "=========================================================="

  # 5. Execute task with retry backoff for transient rate limits (429/503)
  MAX_RETRIES=2
  ATTEMPT=0
  TASK_SUCCESS=false

  while [[ $ATTEMPT -le $MAX_RETRIES ]]; do
    ATTEMPT=$((ATTEMPT + 1))
    echo "[+] Preparing worktree for $TASK_ID (attempt $ATTEMPT/$((MAX_RETRIES + 1)))..."
    "$SCRIPT_DIR/scripts/run-task.sh" --repo "$TARGET_DIR" --task "$TASK_ID"
    WORKTREE_PATH="$TARGET_DIR/.worktrees/$TASK_ID"

    # 6. Dispatch Worker to implement the task
    echo "[+] Dispatching worker on $TASK_ID..."
    PROMPT="Read .amase-rules.md and implement task $TASK_ID: $TASK_DESC. Verify all tests pass with exit code 0. When finished, commit your changes with git."

    if "$SCRIPT_DIR/scripts/dispatch-worker.sh" "$WORKTREE_PATH" "$PROMPT"; then
      echo "[+] Worker reported completion for $TASK_ID. Settling..."

      # 7. Settle task (tests gate -> diff audit -> merge -> backlog update -> worktree prune)
      if "$SCRIPT_DIR/scripts/settle-task.sh" --repo "$TARGET_DIR" --task "$TASK_ID"; then
        TASK_SUCCESS=true

        UPDATED_DONE=$(grep -cE "^- \[x\]" "$BACKLOG_FILE" 2>/dev/null || true)
        UPDATED_DONE=${UPDATED_DONE:-$DONE_TASKS}
        UPDATED_REMAINING=$((TOTAL_TASKS - UPDATED_DONE))
        [[ "$UPDATED_REMAINING" -lt 0 ]] && UPDATED_REMAINING=0
        UPDATED_PCT=0
        if [[ "$TOTAL_TASKS" -gt 0 ]]; then
          UPDATED_PCT=$(( (UPDATED_DONE * 100) / TOTAL_TASKS ))
        fi

        echo ""
        echo "=========================================================="
        echo " [✓] TASK COMPLETED & SETTLED: $TASK_ID"
        echo " [✓] Title:    $TASK_DESC"
        echo " [✓] Merged:   feature/$TASK_ID -> main"
        echo " [✓] Progress: $UPDATED_DONE/$TOTAL_TASKS completed ($UPDATED_PCT%) | $UPDATED_REMAINING pending"
        echo "=========================================================="
        echo ""

        # 8. Post-merge Sentinel Audit Gate
        if [[ -x "$SCRIPT_DIR/scripts/sentinel.py" ]]; then
          echo "[+] Running Sentinel security audit on merged commit..."
          python3 "$SCRIPT_DIR/scripts/sentinel.py" --repo "$TARGET_DIR" 2>/dev/null || true
        fi
        break
      else
        echo "[-] Settlement rejected $TASK_ID (validation failed or empty diff). Cleaning worktree..."
        if [[ -f "$SCRIPT_DIR/scripts/diagnose-failure.py" ]]; then
          python3 "$SCRIPT_DIR/scripts/diagnose-failure.py" "$TARGET_DIR" "$TASK_ID" "settle-rejected" "" 0 "SETTLEMENT_REJECTED" 2>/dev/null || true
        fi
        "$SCRIPT_DIR/scripts/abort-task.sh" --repo "$TARGET_DIR" --task "$TASK_ID" 2>/dev/null || true
      fi
    else
      echo ""
      echo "=========================================================="
      echo " [!] TASK ATTEMPT $ATTEMPT FAILED: $TASK_ID"
      echo " [!] Cleaning worktree before next retry..."
      echo "=========================================================="
      "$SCRIPT_DIR/scripts/abort-task.sh" --repo "$TARGET_DIR" --task "$TASK_ID" 2>/dev/null || true
      if [[ $ATTEMPT -le $MAX_RETRIES ]]; then
        BACKOFF_SECS=$((ATTEMPT * 30))
        echo "[!] Cooling down ${BACKOFF_SECS}s for provider rate limits before retry attempt $((ATTEMPT + 1))..."
        sleep "$BACKOFF_SECS"
      fi
    fi
  done

  if [[ "$TASK_SUCCESS" == "false" ]]; then
    echo "[-] Worker failed all $MAX_RETRIES retries on $TASK_ID. Worktree cleanly pruned. Halting autonomous loop for inspection."
    exit 1
  fi

  if [[ "${AMASE_ONCE:-0}" == "1" ]]; then
    echo "[+] Single-task execution complete (--once). Exiting."
    exit 0
  fi
done
